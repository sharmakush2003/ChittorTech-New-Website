rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. RECOGNITION: Secured by the Shahi Gatekeeper
    match /recognition/{document=**} {
      allow read: if true;
      allow write: if request.resource.data.shahiAuthKey == 'CT_SECRET_GATEWAY_2026';
    }

    // 2. ADMIN AUTH: Keep users private but readable for login checks
    match /users/{userId} {
      allow read: if true;
      allow write: if false;
    }

    // 3. LEADS PIPELINE & ADMIN CRM: Public can create, Admin can manage
    match /leads/{leadId} {
      allow read, write: if true;
    }

    // 4. PAYMENTS & TRANSACTIONS: Verified Cashfree receipts
    match /payments/{paymentId} {
      allow read, write: if true;
    }

    // 5. B2B OUTBOUND LEADS: Google Maps Realtime Cloud CRM
    match /b2b_leads/{leadId} {
      allow read, write: if true;
    }

    // 6. ADMIN SESSIONS & AUDIT TRAIL: Realtime Security Audit Logs
    match /admin_sessions/{sessionId} {
      allow read, write: if true;
    }
  }
}
